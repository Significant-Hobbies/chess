{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "api/**/*.ts",
      "tests/**/*.ts",
      "vite.config.ts",
      "playwright.config.ts"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "preset": "recommended"
      },
      "suspicious": {
        "preset": "recommended"
      }
    }
  }
}
