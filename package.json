{
  "name": "chess-coach",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cd server && npm install --silent && node index.mjs & vite",
    "dev:frontend": "vite",
    "server": "cd server && npm install --silent && node index.mjs",
    "build": "vite build",
    "lint": "biome lint",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:coverage": "BROWSER_COVERAGE=1 playwright test tests/coverage.spec.ts",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "format:check": "node scripts/check-code-health.mjs format",
    "prepare": "husky",
    "knip": "knip --no-exit-code --reporter symbols",
    "knip:strict": "knip --reporter symbols",
    "quality:unused": "node scripts/check-code-health.mjs unused",
    "quality:complexity": "node scripts/check-code-health.mjs complexity",
    "quality:duplication": "node scripts/check-code-health.mjs duplication",
    "quality:cycles": "node scripts/check-code-health.mjs cycles",
    "quality:dependencies": "node scripts/check-code-health.mjs dependencies",
    "quality:suppressions": "node scripts/check-code-health.mjs suppressions",
    "quality:hygiene": "node scripts/check-code-health.mjs hygiene",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:coverage && pnpm quality:unused && pnpm quality:complexity && pnpm quality:duplication && pnpm quality:cycles && pnpm quality:dependencies && pnpm quality:suppressions && pnpm build && pnpm quality:hygiene"
  },
  "dependencies": {
    "@saas-maker/feedback": "^0.4.0",
    "chess.js": "1.4.0",
    "lucide-react": "1.27.0",
    "posthog-js": "^1.407.3",
    "react": "19.2.8",
    "react-chessboard": "5.10.0",
    "react-dom": "19.2.8",
    "stockfish": "18.0.8"
  },
  "devDependencies": {
    "@astrojs/mdx": "7.0.5",
    "@astrojs/react": "6.0.2",
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "1.62.0",
    "@shikijs/twoslash": "4.4.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "25.6.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "6.0.4",
    "astro": "7.2.1",
    "blume": "0.8.0",
    "husky": "^9.1.7",
    "jscpd": "5.0.14",
    "knip": "^6.29.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "wrangler": "4.120.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "workerd"
    ],
    "overrides": {
      "dompurify": "3.4.13",
      "nanoid@<3.3.18": "3.3.18",
      "undici@<6.27.0": "6.28.0",
      "undici@>=7.0.0 <7.29.0": "7.29.0"
    }
  }
}
