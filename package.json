{
  "name": "chess-coach",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cd server && npm install --silent && node index.mjs & vite",
    "dev:frontend": "vite",
    "server": "cd server && npm install --silent && node index.mjs",
    "build": "vite build",
    "lint": "biome lint",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "prepare": "husky",
    "knip": "knip --no-exit-code --reporter symbols",
    "knip:strict": "knip --reporter symbols"
  },
  "dependencies": {
    "@saas-maker/feedback": "^0.2.1",
    "chess.js": "1.4.0",
    "lucide-react": "1.27.0",
    "posthog-js": "^1.407.3",
    "react": "19.2.8",
    "react-chessboard": "5.10.0",
    "react-dom": "19.2.8",
    "stockfish": "18.0.8"
  },
  "devDependencies": {
    "@astrojs/mdx": "7.0.3",
    "@astrojs/react": "6.0.1",
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "1.62.0",
    "@shikijs/twoslash": "4.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19",
    "@vercel/node": "5.8.27",
    "@vitejs/plugin-react": "6.0.4",
    "astro": "7.1.3",
    "blume": "0.8.0",
    "husky": "^9.1.7",
    "knip": "^6.29.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "8.1.5"
  }
}
